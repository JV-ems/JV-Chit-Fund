{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": [
        "index.html",
        "styles.css",
        "chitConfig.js",
        "assests/**",
        "Images JV/**"
      ]
    }
  },
  "rewrites": [
    {
      "source": "/assets/(.*)",
      "destination": "/assests/$1"
    },
    {
      "source": "/Images%20JV/(.*)",
      "destination": "/Images JV/$1"
    },
    {
      "source": "/api",
      "destination": "/api/index.js"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    }
  ]
}


