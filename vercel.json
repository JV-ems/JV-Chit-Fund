{
  "version": 2,
  "routes": [
    {
      "src": "/styles.css",
      "dest": "/styles.css"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/assests/$1"
    },
    {
      "src": "/Images%20JV/(.*)",
      "dest": "/Images JV/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    }
  ]
}

