{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": "index.html"
    }
  },
  "rewrites": [
    {
      "source": "/assets/(.*)",
      "destination": "/assests/$1"
    },
    {
      "source": "/Images%20JV/(.*)",
      "destination": "/Images JV/$1"
    },
    {
      "source": "/api",
      "destination": "/api/index.js"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    }
  ]
}


