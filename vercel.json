{
  "version": 2,
  "crons": [
    {
      "path": "/api/cron/monthly-backup",
      "schedule": "0 0 1 * *"
    },
    {
      "path": "/api/cron/daily-test-backup",
      "schedule": "0 9 * * *"
    }

  ],
  "routes": [
    {
      "src": "/styles.css",
      "dest": "/styles.css"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/assests/$1"
    },
    {
      "src": "/Images%20JV/(.*)",
      "dest": "/Images JV/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    }
  ]
}
